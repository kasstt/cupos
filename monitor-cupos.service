# Servicio systemd: mantiene el monitor corriendo y lo levanta solo si el
# servidor se reinicia o el script se cae.
#
# Instalar:
#   sudo cp monitor-cupos.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monitor-cupos

[Unit]
Description=Monitor de cupos UBB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor
WorkingDirectory=/home/monitor/monitor-cupos
EnvironmentFile=/etc/monitor-cupos.env
ExecStart=/home/monitor/monitor-cupos/.venv/bin/python monitor_cupos.py --headless
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
